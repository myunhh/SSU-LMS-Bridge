# ============================================================
# Frontend 환경 변수 템플릿
# 이 파일을 복사해서 `frontend/.env` 를 만들고 값을 채우세요.
# ⚠️ 여기에 적힌 값은 빌드 결과물에 박혀 모든 사용자에게 공개됩니다.
#    비밀번호 / API 키 같은 secret 은 절대 여기 넣지 마세요.
# ============================================================

# ── 백엔드 연결 ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ── 데모/개발용 사용자 정보 ───────────────────────────────────
VITE_DEMO_USER_NAME=
VITE_DEMO_STUDENT_ID=
VITE_DEMO_USER_EMAIL=
VITE_DEMO_USER_MAJOR=

# ── 앱 메타 ──────────────────────────────────────────────────
VITE_APP_NAME=LMS Bridge
VITE_APP_VERSION=0.6.2
