# ============================================================
# LMS-Bridge 백엔드 환경 변수 템플릿
# 이 파일을 복사해서 **프로젝트 루트의 `.env`** 를 만들고 실제 값을 채워주세요.
# (backend/app/config.py 는 루트 .env 만 읽습니다 — backend/.env 아님)
# ⚠️  .env 는 절대 Git 에 커밋하지 마세요.
#     프론트엔드용 변수(VITE_*)는 frontend/.env 에 따로 둡니다.
#     'xxxx' 가 들어간 값은 placeholder 로 간주되어 미설정 취급됩니다.
# ============================================================

# ── LMS 계정 ────────────────────────────────────────────────
# LMS_USERNAME 은 frontend/.env 의 VITE_DEMO_STUDENT_ID 와 동일하게 유지하세요.
LMS_USERNAME=
# LMS_PASSWORD 는 비워두세요. 사용자가 회원가입 폼에서 입력해 저장됩니다.
# LMS_PASSWORD=
LMS_BASE_URL=https://lms.ssu.ac.kr
# 통합 로그인(SSO) 권장. 일반 로그인: xn-sso-dir-general
LMS_LOGIN_TYPE=xn-sso-dir-sso

# ── Notion ──────────────────────────────────────────────────
# https://www.notion.so/my-integrations 에서 발급
NOTION_TOKEN=secret_xxxx
# LMS-Bridge 루트 페이지 ID (Notion URL 마지막 32자리)
NOTION_ROOT_PAGE_ID=xxxx

# ── Obsidian ────────────────────────────────────────────────
# ⚠️ OBSIDIAN_VAULT_PATH 는 절대경로가 아니라 **vault 내부 상대 경로**입니다.
#    vault 루트에 바로 저장하려면 비워두세요(보통 비움). 하위 폴더 예: LMS
OBSIDIAN_VAULT_PATH=
# Obsidian Local REST API 플러그인의 API Key
OBSIDIAN_MCP_AUTH_CODE=
OBSIDIAN_VAULT_NAME=LMS_Bridge_Vault
# Local REST API 베이스 URL — 플러그인 기본값: 27124=HTTPS(자가서명), 27123=HTTP
OBSIDIAN_BASE_URL=http://localhost:27124

# ── LLM ─────────────────────────────────────────────────────
# 프로바이더: gemini | openai | anthropic (기본: gemini)
LLM_PROVIDER=gemini
# Google AI Studio (aistudio.google.com) → 'Get API key' 에서 발급 (AIza… 형태)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ── 세션 캐시 ────────────────────────────────────────────────
# Playwright storage_state 저장 경로 — 상대경로면 프로젝트 루트 기준 (기본값 권장)
SESSION_CACHE_PATH=.cache/session_state.json

# ── 동기화 설정 ─────────────────────────────────────────────
SYNC_INTERVAL_HOURS=24
# 동기화 실행 시각 (스마트캠퍼스 LMS 새벽 3시 갱신 이후 권장 — 낮추지 말 것)
SYNC_HOUR=4
# 동기화 시 강의자료 '원본 파일'(PPT/PDF/문서)을 받아 Obsidian 에 저장할지.
# ⚠️ content_id 파악을 위해 강의자료 LTI 를 항목당 1회 런치하며, 그때 '출결/진도'가
#    기록될 수 있습니다. 매니페스트 캐시로 항목당 1번만 런치하고, 이미 받은 파일·영상·
#    외부링크는 다시 런치하지 않습니다. Obsidian 미설정이면 true 라도 동작 안 함.
DOWNLOAD_FILES=true

# ── 이메일 알림 (#9) ─────────────────────────────────────────
# 마감 임박 과제 / 신규 공지를 이메일로 발송합니다 (SMTP).
# 아래 SMTP_HOST · NOTIFY_FROM · NOTIFY_TO 가 모두 채워져야 활성화됩니다.
# 비워두면(또는 'xxxx') 발송은 no-op 이고 스캔 스케줄러도 등록되지 않습니다.
# ⚠️ 실제 푸시(FCM/웹푸시)·데스크탑 알림은 범위 밖 — 이메일만 동작합니다.
# 예) Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, 앱 비밀번호 사용.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 발신 주소
NOTIFY_FROM=
# 수신 주소 (콤마로 여러 명 지정 가능: a@x.com,b@y.com)
NOTIFY_TO=
# 마감 임박 알림 임계(시간) — due 가 now ~ now+N시간 이내인 미제출 과제 발송
NOTIFY_DEADLINE_HOURS=24
# 스캔 주기(분) — 이 주기마다 마감 임박/신규 공지를 스캔해 발송
NOTIFY_SCAN_INTERVAL_MINUTES=60

# ── 웹 서버 포트 ─────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── 개발 / 디버그 ────────────────────────────────────────────
LOG_LEVEL=INFO
# false 로 설정하면 Playwright 가 헤드리스가 아닌 브라우저 창으로 실행
PLAYWRIGHT_HEADLESS=true
