# ============================================================
# LMS-Bridge 환경 변수 템플릿
# 이 파일을 복사해서 .env 를 만들고 실제 값을 채워주세요.
# ⚠️  .env 는 절대 Git 에 커밋하지 마세요.
# ============================================================

# ── LMS 계정 ────────────────────────────────────────────────
LMS_USERNAME=
LMS_PASSWORD=
LMS_BASE_URL=https://lms.ssu.ac.kr
# 통합 로그인(SSO) 권장. 일반 로그인: xn-sso-dir-general
LMS_LOGIN_TYPE=xn-sso-dir-sso

# ── Notion ──────────────────────────────────────────────────
# https://www.notion.so/my-integrations 에서 발급
NOTION_TOKEN=secret_xxxx
# LMS-Bridge 루트 페이지 ID (Notion URL 마지막 32자리)
NOTION_ROOT_PAGE_ID=xxxx

# ── Obsidian Vault (파일 저장소) ────────────────────────────
# 예: /Users/yourname/ObsidianVault/LMS
OBSIDIAN_VAULT_PATH=/path/to/ObsidianVault/LMS

# ── 세션 캐시 ────────────────────────────────────────────────
# Playwright storage_state 저장 경로 (기본값 사용 권장)
SESSION_CACHE_PATH=.cache/session_state.json

# ── 동기화 설정 ─────────────────────────────────────────────
SYNC_INTERVAL_HOURS=24
# 동기화 실행 시각 (스마트캠퍼스 LMS 새벽 3시 갱신 이후 권장)
SYNC_HOUR=4
DOWNLOAD_FILES=true

# ── 개발 / 디버그 ────────────────────────────────────────────
LOG_LEVEL=INFO
# true 로 설정하면 Playwright 를 헤드리스가 아닌 브라우저 창으로 실행
PLAYWRIGHT_HEADLESS=true
